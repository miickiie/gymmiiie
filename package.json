{
  "name": "gymmiie",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GymMane-inspired offline-first gym log, rebuilt as a Cloudflare web app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/build.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:dev": "npm run build && wrangler dev",
    "db:create": "wrangler d1 create gymmiie",
    "db:migrate": "wrangler d1 migrations apply gymmiie --remote",
    "db:migrate:local": "wrangler d1 migrations apply gymmiie --local",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p worker/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:exercises": "node scripts/audit-exercises.mjs",
    "patch:exercises": "node scripts/patch-exercises.mjs",
    "validate:exercises": "node scripts/validate-exercises.mjs",
    "measure:build": "node scripts/measure-build.mjs",
    "test:serve": "node scripts/test-server.mjs",
    "types:worker": "CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false WRANGLER_SEND_METRICS=false WRANGLER_LOG_PATH=/tmp/gymmiie-types.log wrangler types worker/worker-configuration.d.ts --include-runtime=false --env-file /dev/null"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "idb-keyval": "^6.2.1",
    "immer": "^11.2.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.2.8",
    "miniflare": "5.20261104.0-beta",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0"
  }
}
